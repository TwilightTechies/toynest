{
  "name": "@toynest/adapters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sample-catalog": "./src/in-memory/sample-catalog.ts",
    "./sample-support": "./src/in-memory/sample-support.ts",
    "./sample-cart": "./src/in-memory/sample-cart.ts",
    "./anthropic": "./src/anthropic/anthropic-provider.ts",
    "./supabase": "./src/supabase/index.ts",
    "./images": "./src/images/sharp-image-processor.ts",
    "./payments": "./src/payments/mock-payment-provider.ts",
    "./sample-checkout": "./src/in-memory/sample-checkout.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo:draft": "node --env-file-if-exists=../../.env.local --import tsx scripts/draft-demo.ts",
    "test": "vitest run",
    "seed:supabase": "node --env-file-if-exists=../../.env.local --import tsx scripts/seed-supabase.ts",
    "admin:create": "node --env-file-if-exists=../../.env.local --import tsx scripts/create-admin.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@anthropic-ai/sdk": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@toynest/ai": "0.0.0",
    "@toynest/core": "0.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
