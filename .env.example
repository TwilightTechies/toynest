# Copy to .env.local (gitignored) at the repo root and fill in. Server-only: never prefix with NEXT_PUBLIC_.

# Claude API (personal Console key)
ANTHROPIC_API_KEY=
# TOYNEST_MODEL=claude-opus-5-5

# Supabase: Project Settings → API. Without these, the app uses data/*.json instead.
SUPABASE_URL=
# Public "anon" / publishable key: subject to Row Level Security. Used by the RLS integration test.
SUPABASE_ANON_KEY=
# "service_role" / secret key: BYPASSES RLS. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
